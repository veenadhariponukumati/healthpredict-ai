{
  "active": false,
  "name": "Care Team Notification",
  "nodes": [
    {
      "parameters": {
        "path": "care-team-notification",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "159f6b25-1c72-4ee0-92e0-8ab271873d86"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.workflow_id }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.patient_id }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.risk_level }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"action\": \"care_team_notification\",\n  \"status\": \"rejected\",\n  \"error\": \"Missing required fields: workflow_id, patient_id, risk_level\"\n}"
      },
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"execution_id\": \"{{ $json.execution_id }}\",\n  \"action\": \"care_team_notification\",\n  \"status\": \"delivered\",\n  \"timestamp\": \"{{ $now.toISO() }}\",\n  \"mock\": {\n    \"recipient\": \"care-team@hospital.local\",\n    \"channel\": \"webhook\",\n    \"message\": \"Patient {{ $json.body.patient_id }} flagged as {{ $json.body.risk_level }} risk (score: {{ $json.body.risk_score }})\"\n  }\n}"
      },
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json['X-Integration-Secret'] || $json.headers?.x_integration_secret || $json.headers?.['x-integration-secret'] || '' }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Check Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [350, 500]
    },
    {
      "parameters": {
        "jsCode": "// Generate mock execution ID\n$json.execution_id = 'n8n-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 8);\nreturn $json;"
      },
      "name": "Add Execution ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [550, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
