{
  "active": false,
  "name": "Patient Reminder",
  "nodes": [
    {
      "parameters": {
        "path": "patient-reminder",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "384d17b1-0d1f-44c9-a0c3-06b6086a3c35"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.workflow_id }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.patient_id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"action\": \"patient_reminder\",\n  \"status\": \"rejected\",\n  \"error\": \"Missing required fields: workflow_id, patient_id\"\n}"
      },
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 500]
    },
    {
      "parameters": {
        "jsCode": "$json.execution_id = 'n8n-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 8);\nreturn $json;"
      },
      "name": "Add Execution ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [550, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"execution_id\": \"{{ $json.execution_id }}\",\n  \"action\": \"patient_reminder\",\n  \"status\": \"sent\",\n  \"timestamp\": \"{{ $now.toISO() }}\",\n  \"mock\": {\n    \"channel\": \"sms\",\n    \"phone\": \"+1-555-0000\",\n    \"message\": \"Reminder: Please attend your follow-up appointment. Reply HELP for info.\",\n    \"patient_id\": \"{{ $json.body.patient_id }}\"\n  }\n}"
      },
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json['X-Integration-Secret'] || $json.headers?.x_integration_secret || $json.headers?.['x-integration-secret'] || '' }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Check Auth",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [350, 500]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Check Auth", "type": "main", "index": 0}]]
    },
    "Check Auth": {
      "main": [
        [{"node": "Validate Input", "type": "main", "index": 0}],
        [{"node": "Reject", "type": "main", "index": 0}]
      ]
    },
    "Validate Input": {
      "main": [
        [{"node": "Add Execution ID", "type": "main", "index": 0}],
        [{"node": "Reject", "type": "main", "index": 0}]
      ]
    },
    "Add Execution ID": {
      "main": [[{"node": "Respond Success", "type": "main", "index": 0}]]
    }
  },
  "settings": {}
}