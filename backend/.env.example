# ── Application Environment ─────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
APP_NAME=readmission-platform-backend

# ── Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:dev_password@localhost:5432/readmission
DATABASE_SYNC_URL=postgresql://app:dev_password@localhost:5432/readmission
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Security ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
SECURITY_HEADERS_ENABLED=true

# ── OpenTelemetry ───────────────────────────────────────────────────
OTEL_ENABLED=false
# ── Temporal ────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_TASK_QUEUE=care-coordination
TEMPORAL_WORKER_CONCURRENCY=5

# ── n8n ─────────────────────────────────────────────────────────────
N8N_BASE_URL=http://n8n:5678/webhook
N8N_INTEGRATION_SECRET=dev-integration-secret

# ── Retry Configuration ────────────────────────────────────────────
RETRY_INITIAL_INTERVAL=5
RETRY_BACKOFF=2.0
RETRY_MAX_INTERVAL=60
RETRY_MAX_ATTEMPTS=3

# ── Workflow Service ───────────────────────────────────────────────
WORKFLOW_SERVICE_URL=http://workflow:8004
